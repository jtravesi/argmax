{
	"name": "argmax",
	"private": true,
	"version": "0.0.0",
	"description": "Decision making under uncertainty with multi-attribute expected utility. Runs entirely in the browser.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jtravesi/argmax.git"
	},
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"check:budget": "node scripts/check-budget.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26",
		"@vitest/coverage-v8": "^4.1.12",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"fast-check": "^4.10.2",
		"globals": "^17.6.0",
		"katex": "^0.19.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"rehype-katex": "^7.0.1",
		"rehype-slug": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-math": "^6.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"unified": "^11.0.5",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"lz-string": "^1.5.0",
		"zod": "^4.6.7"
	},
	"overrides": {
		"katex": "$katex"
	}
}
